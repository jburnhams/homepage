#!/bin/bash
# Launcher: runs the homepage server from its locked environment (needs uv; the first run builds .venv from uv.lock).
export PATH="$HOME/.local/bin:$PATH"   # where uv usually is, and a systemd user unit does not have it
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec uv run --locked --project "$ROOT" homepage "$@"
